{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpsFeast system inventory result 0.2.0",
  "type": "object",
  "required": [
    "schema_version",
    "recipe",
    "host_id",
    "status",
    "observations",
    "sources",
    "execution_errors"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "recipe": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "inventory-system"
        },
        "version": {
          "type": "string"
        },
        "recipe_version": {
          "type": "string"
        },
        "implementation_id": {
          "type": "string"
        },
        "implementation_version": {
          "type": "string"
        },
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "host_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "partial",
        "failed",
        "unsupported",
        "skipped"
      ]
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname",
        "platform",
        "system_name",
        "system_version",
        "kernel_name",
        "kernel_release",
        "architecture"
      ],
      "properties": {
        "hostname": {
          "$ref": "#/$defs/observation"
        },
        "platform": {
          "$ref": "#/$defs/observation"
        },
        "system_name": {
          "$ref": "#/$defs/observation"
        },
        "system_version": {
          "$ref": "#/$defs/observation"
        },
        "kernel_name": {
          "$ref": "#/$defs/observation"
        },
        "kernel_release": {
          "$ref": "#/$defs/observation"
        },
        "architecture": {
          "$ref": "#/$defs/observation"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "execution_errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "schema_version",
        "method",
        "quality",
        "evidence",
        "warnings"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "method": {
          "enum": [
            "source-host-id",
            "linux-machine-id-hmac-sha256-v1",
            "configured-identity-key-v1"
          ]
        },
        "quality": {
          "enum": [
            "fallback",
            "machine-derived",
            "user-assigned"
          ]
        },
        "os_instance_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identity_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retention": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "stored",
            "already_stored",
            "skipped",
            "failed"
          ]
        },
        "observation_id": {
          "type": "string"
        },
        "host_key": {
          "type": "string"
        },
        "identity_quality": {
          "enum": [
            "fallback",
            "machine-derived",
            "user-assigned"
          ]
        },
        "reason_code": {
          "type": "string"
        }
      }
    },
    "host_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "inventory_contract_version": {
      "const": "0.1.0"
    },
    "inventory": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Inventory values 0.1.0",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "hardware",
        "storage",
        "network",
        "software",
        "services"
      ],
      "properties": {
        "system": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hostname",
            "platform",
            "system_name",
            "system_version",
            "kernel_name",
            "kernel_release",
            "architecture",
            "uptime_seconds",
            "timezone",
            "virtualization"
          ],
          "properties": {
            "hostname": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144
            },
            "platform": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144
            },
            "system_name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144
            },
            "system_version": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144
            },
            "kernel_name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144
            },
            "kernel_release": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144
            },
            "architecture": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144
            },
            "uptime_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "timezone": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144
            },
            "virtualization": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144
            }
          }
        },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu_model",
            "logical_cpus",
            "memory_total_bytes",
            "vendor",
            "model",
            "serial",
            "uuid"
          ],
          "properties": {
            "cpu_model": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144
            },
            "logical_cpus": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "memory_total_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "vendor": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144
            },
            "model": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144
            },
            "serial": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144
            },
            "uuid": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filesystems",
            "block_devices"
          ],
          "properties": {
            "filesystems": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 2000,
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "block_devices": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 2000,
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interfaces",
            "routes",
            "dns_servers",
            "listening_endpoints"
          ],
          "properties": {
            "interfaces": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 2000,
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "routes": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 2000,
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "dns_servers": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 2000,
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "listening_endpoints": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 2000,
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "software": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packages"
          ],
          "properties": {
            "packages": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 2000,
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "services"
          ],
          "properties": {
            "services": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 2000,
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "$comment": "Missing values are null; CSV uses empty cells. Last modified: 2026-10-14"
    },
    "collection_process": {
      "type": "object"
    },
    "access": {
      "type": "object"
    },
    "access_check": {
      "type": "object"
    },
    "retention_snapshot": {
      "$ref": "../../../schemas/retention-snapshot.schema.json"
    },
    "content_update": {
      "$ref": "../../../schemas/raw-retention-context.schema.json#/properties/content_update"
    },
    "source_observation_id": {
      "type": "string",
      "format": "uuid"
    },
    "execution_access_mode": {
      "enum": [
        "read",
        "write",
        "unknown"
      ]
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "required": [
        "value",
        "status",
        "observed_at",
        "source_ids",
        "error"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "success",
            "unavailable",
            "unsupported",
            "permission_denied",
            "timeout",
            "command_failed",
            "parsing_failed",
            "not_attempted"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  },
  "dependentRequired": {
    "inventory_contract_version": [
      "inventory"
    ],
    "inventory": [
      "inventory_contract_version"
    ]
  },
  "$comment": "Last modified: 2026-10-19 11:57:21"
}
