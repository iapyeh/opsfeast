          "properties": {
            "hostname": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144,
              "description": "Observed hostname; not proof of global identity",
              "unit": ""
            },
            "platform": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144,
              "description": "Observed OS platform description",
              "unit": ""
            },
            "system_name": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144,
