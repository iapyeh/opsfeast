{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory/system retained observations 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "observation_id",
    "source_id",
    "host_id",
    "host_key",
    "identity_method",
    "identity_quality",
    "identity_evidence",
    "identity_warning",
    "recipe_id",
    "recipe_version",
    "raw_schema_version",
    "started_at",
    "observed_at",
    "evidence_kind",
    "status",
    "observations"
