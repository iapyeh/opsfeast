  "properties": {
    "contract_version": {
      "const": "0.1.0",
      "description": "Contract version."
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}:[0-9a-f]{64}$",
      "description": "Observation id."
    },
    "source_id": {
      "type": "string",
      "format": "uuid",
      "description": "Source id."
    },
    "host_id": {
      "type": "string",
      "minLength": 1,
      "description": "Host id."
    },
    "host_key": {
      "type": "string",
      "minLength": 1,
      "description": "Native or source-scoped environment evidence; logical management identity is namespace + host_id"
    },
    "identity_method": {
      "enum": [
        "source-host-id",
        "linux-machine-id-hmac-sha256-v1",
        "configured-identity-key-v1"
      ],
      "description": "Identity method."
    },
    "identity_quality": {
      "enum": [
        "fallback",
        "machine-derived",
        "user-assigned"
      ],
      "description": "Identity quality."
    },
    "identity_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "scope",
          "value",
          "observed_at"
        ],
        "properties": {
          "kind": {
            "enum": [
              "system-serial",
              "enclosure-serial",
              "hardware-uuid"
            ]
          },
          "scope": {
            "const": "device"
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{6}\\+00:00$"
          }
        }
      },
      "description": "Identity evidence."
    },
    "identity_warning": {
      "type": "string",
      "minLength": 1,
      "description": "Mandatory interpretation context; never omit fallback/identity uncertainty"
    },
    "recipe_id": {
      "const": "inventory-system",
      "description": "Recipe id."
    },
    "recipe_version": {
      "type": "string",
      "minLength": 1,
      "description": "Recipe version."
    },
    "raw_schema_version": {
      "const": "0.2.0",
      "description": "Raw schema version."
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{6}\\+00:00$",
      "description": "Started at."
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{6}\\+00:00$",
      "description": "Observed at."
    },
    "evidence_kind": {
      "enum": [
        "local",
        "ssh"
      ],
      "description": "Evidence kind."
    },
    "status": {
      "enum": [
        "success",
        "partial"
      ],
      "description": "Status."
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
