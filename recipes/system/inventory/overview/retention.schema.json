          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "status",
            "observed_at"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "success",
                "unavailable",
                "unsupported",
                "permission_denied",
                "timeout",
                "command_failed",
                "parsing_failed",
                "not_attempted"
              ]
            },
            "observed_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{6}\\+00:00$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "success"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observed_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{6}\\+00:00$"
                  }
                }
              },
              "else": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              }
            }
          ],
          "description": "Observed hostname; not proof of global identity",
          "unit": ""
        },
