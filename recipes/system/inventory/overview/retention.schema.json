                "null"
              ],
              "maxLength": 262144,
              "description": "Observed kernel release",
              "unit": ""
            },
            "architecture": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144,
              "description": "Observed machine architecture",
              "unit": ""
            },
            "uptime_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "Seconds since the OS boot according to the bounded platform query",
              "unit": "seconds"
            },
            "timezone": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144,
              "description": "Reported OS timezone label; unavailable when not exposed",
              "unit": ""
            },
            "virtualization": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 262144,
