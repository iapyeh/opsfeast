{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "OpsFeast additive raw replay context 0.1.0",
  "properties": {
    "source_observation_id": {
      "type": "string",
      "format": "uuid"
    },
    "execution_access_mode": {
      "enum": [
        "read",
        "write",
        "unknown"
      ]
    },
    "retention_snapshot": {
      "$ref": "retention-snapshot.schema.json"
    },
    "producer_instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "content_update": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "success",
            "skipped",
            "failed"
          ]
        },
        "reason_code": {
          "type": "string"
        },
        "recovery": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "execution_receipt": {
      "type": "object",
      "additionalProperties": false,
      "description": "Post-collection staged execution receipt; excluded from the observation business digest.",
      "required": [
        "schema_version",
        "execution_id",
        "execution_status",
        "river"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "execution_id": {
          "type": "string",
          "format": "uuid"
        },
        "execution_status": {
          "enum": [
            "waiting",
            "running",
            "success",
            "partial",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "river": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "reader_url",
            "history_url"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "reader_url": {
              "type": "string"
            },
            "history_url": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$comment": "Last modified: 2026-11-18 16:03:00"
}
