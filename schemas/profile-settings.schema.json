{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile settings status 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "default_profile", "profiles", "connectivity_verified"],
  "properties": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "default_profile": {"type": ["string", "null"]},
    "connectivity_verified": {"const": false},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "root", "status", "active", "namespace", "definition_status"],
        "properties": {
          "name": {"type": "string"},
          "root": {"type": "string"},
          "status": {"enum": ["available", "unavailable"]},
          "active": {"type": "boolean"},
          "namespace": {"type": ["string", "null"]},
          "definition_status": {"enum": ["present", "missing", "invalid", "unknown"]}
        }
      }
    }
  },
  "$comment": "Last modified: 2026-11-01 13:20:29"
}
