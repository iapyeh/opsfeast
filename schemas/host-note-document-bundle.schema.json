{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host-note document bundle 0.1.0",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "entry",
        "kind",
        "files",
        "warnings"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "kind": {
          "enum": [
            "markdown",
            "html"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "title",
        "entry",
        "kind",
        "file_count",
        "bytes",
        "sha256",
        "created_at"
      ],
      "properties": {
        "uuid": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "kind": {
          "enum": [
            "markdown",
            "html"
          ]
        },
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "reference",
        "reason"
      ],
      "properties": {
        "file": {
          "type": "string",
          "maxLength": 500
        },
        "reference": {
          "type": "string",
          "maxLength": 500
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  },
  "$comment": "Paths, sizes, UUID ownership, revisions and sandbox requirements are enforced by runtime validation. Last modified: 2026-11-12 12:30:01"
}
