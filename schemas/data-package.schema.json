{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpsFeast data package manifest 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "package_id",
    "created_at",
    "files"
  ],
  "properties": {
    "format": {
      "const": "opsfeast-data-package"
    },
    "version": {
      "const": "0.1.0"
    },
    "package_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "$comment": "Last modified: 2026-10-25 15:08:41"
}
