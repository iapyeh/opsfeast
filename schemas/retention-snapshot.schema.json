{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "OpsFeast data-only retention snapshot 0.2.0",
  "required": [
    "contract_version",
    "recipe_id",
    "recipe_version",
    "access_mode",
    "retention",
    "sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "0.2.0"
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1
    },
    "recipe_version": {
      "type": "string",
      "minLength": 1
    },
    "access_mode": {
      "enum": [
        "read",
        "write",
        "unknown"
      ]
    },
    "retention": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "version",
            "fields",
            "description"
          ],
          "properties": {
            "contract": {
              "const": "host-values"
            },
            "version": {
              "const": "0.2.0"
            },
            "fields": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "unit",
                  "description"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "string",
                      "number",
                      "integer",
                      "boolean"
                    ]
                  },
                  "unit": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "version",
            "description",
            "schema"
          ],
          "properties": {
            "contract": {
              "const": "inventory-observations"
            },
            "version": {
              "const": "0.1.0"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "schema": {
              "const": "retention.schema.json"
            }
          }
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normalizer_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "retention": {
            "type": "object",
            "properties": {
              "contract": {
                "const": "inventory-observations"
              }
            },
            "required": [
              "contract"
            ]
          }
        }
      },
      "then": {
        "required": [
          "normalizer_sha256",
          "schema_sha256"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "normalizer_sha256"
              ]
            },
            {
              "required": [
                "schema_sha256"
              ]
            }
          ]
        }
      }
    }
  ],
  "$comment": "Last modified: 2026-10-19 11:57:21"
}
